# Copia este archivo como .env.local para desarrollo. En Vercel, agrégalas en
# Project → Settings → Environment Variables.

# Contraseña para entrar a /admin (usa una larga, ej. 4 palabras al azar)
ADMIN_PASSWORD=

# Secreto para firmar la sesión (cualquier texto largo y aleatorio).
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# Dominio público del sitio (para enlaces de WhatsApp, SEO y redes)
NEXT_PUBLIC_SITE_URL=https://www.h3seminuevos.com

# (Opcional) Número de WhatsApp en formato internacional sin "+" ni espacios
# NEXT_PUBLIC_WHATSAPP=529932467572

# Las siguientes las agrega Vercel automáticamente al conectar las integraciones:
# Upstash Redis (Marketplace):  KV_REST_API_URL, KV_REST_API_TOKEN
# Vercel Blob (Storage):        BLOB_READ_WRITE_TOKEN
