# Copia este archivo como .env.local para desarrollo. En Netlify, agrégalas en
# Site configuration → Environment variables. Nunca subas los valores reales al repositorio.

# (Opcional) Contraseña inicial de /admin. Si se deja vacía, la inicial es 12345.
# En cualquier caso, cámbiala en Panel → Ajustes (se guarda cifrada en Upstash).
ADMIN_PASSWORD=

# Secreto para firmar la sesión (cualquier texto largo y aleatorio).
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=

# Dominio público del sitio (para enlaces de WhatsApp, SEO y redes).
# Mientras no se conecte el dominio, en Netlify se usa sola la dirección *.netlify.app.
# NEXT_PUBLIC_SITE_URL=https://www.h3seminuevos.com

# (Opcional) Número de WhatsApp en formato internacional sin "+" ni espacios
# NEXT_PUBLIC_WHATSAPP=529932467572

# Inventario: Upstash Redis (plan Free) → consola de Upstash → tu base → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fotos: Cloudinary (plan Free) → Dashboard → "API environment variable"
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
